# ── SAGRI Environment Configuration ──────────────────────
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS
# DO NOT COMMIT REAL CREDENTIALS TO GIT

# ── Backend Configuration ────────────────────────────────
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://sagri.vercel.app

# ── Supabase Credentials ─────────────────────────────────
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ── Fast2SMS API Key ─────────────────────────────────────
FAST2SMS_API_KEY=your-fast2sms-api-key

# ── Google Gemini API Key ─────────────────────────────
# Used by Expert Connect chat (backend) and Disease Detection / Voice Agent (frontend)
GEMINI_API_KEY=your-gemini-api-key

# ── Frontend Configuration (VITE_) ───────────────────────
VITE_BACKEND_URL=http://localhost:8000


CLOUD_RUN_URL=
CORS_ORIGINS=*
