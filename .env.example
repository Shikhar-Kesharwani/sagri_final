# ── SAGRI Environment Configuration ──────────────────────
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS
# DO NOT COMMIT REAL CREDENTIALS TO GIT

# ── Backend Configuration ────────────────────────────────
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://sagri.vercel.app

# ── Supabase Credentials ─────────────────────────────────
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ── Fast2SMS API Key ─────────────────────────────────────
FAST2SMS_API_KEY=your-fast2sms-api-key

# ── Google Gemini API Key ─────────────────────────────
# Used by Expert Connect chat (backend) and Disease Detection / Voice Agent (frontend)
GEMINI_API_KEY=your-gemini-api-key

# ── Frontend Configuration (VITE_) ───────────────────────
VITE_BACKEND_URL=http://localhost:8000

# ── Firebase Authentication (Frontend) ───────────────────
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# ── Supabase (Frontend Optional Overrides) ───────────────
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

CLOUD_RUN_URL=
CORS_ORIGINS=*
